# GitHub配置
github:
  api_token: "your_github_token_here"  # 替换为您的GitHub Token
  search:
    days: 7  # 搜索最近几天的项目
    min_stars: 10  # 最小stars数
    topics: ["ai"]  # 搜索主题

# 爬虫配置
crawler:
  max_retries: 3  # 最大重试次数
  timeout: 30  # 请求超时时间（秒）
  concurrent_limit: 5  # 并发请求限制

# 日志配置
logging:
  level: "INFO"  # 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
  file: "logs/crawler.log"  # 日志文件路径
  max_size: 10485760  # 单个日志文件最大大小（10MB）
  backup_count: 5  # 保留的日志文件数量

# 代理配置（可选）
proxy:
  enabled: false
  http: "http://proxy.example.com:8080"
  https: "https://proxy.example.com:8080" 